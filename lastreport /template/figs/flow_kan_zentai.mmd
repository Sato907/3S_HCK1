    C -- "'E'（演奏終了）" --> G["モータ停止・<br/>LEDマトリクス消灯"]
    E -- yes --> F["回転速度と表示を<br/>新しい段階へ更新"]
    E -- no --> H
    D --> H["受信待ちへ戻る"]
    F --> H
    G --> H
    H --> B
